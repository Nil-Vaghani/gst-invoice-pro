# ══════════════════════════════════════════════════════════
# GST InvoicePro — Environment Configuration Template
# ══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git — it's already in .gitignore

# ── Backend: MongoDB Connection ────────────────────────────
# Get your connection string from MongoDB Atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/database-name?appName=Cluster0
MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/gst-calculator?appName=Cluster0

# ── Backend: Server Port ───────────────────────────────────
# Port where the Express server will run
PORT=5001

# ── Backend: JWT Secret ────────────────────────────────────
# Use a strong, random string for signing JWT tokens
# Example: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# ── Frontend: API Base URL (VITE_ prefix required for Vite) ──
# For development: http://localhost:5001/api
# For production: https://your-backend-url.com/api
VITE_API_BASE_URL=https://gst-invoice-backend-2wcc.onrender.com/api

# ── Frontend: Firebase Web App Config ──────────────────────
# Get these from Firebase Console > Project Settings > Your Apps
# IMPORTANT: These are public keys, safe to expose to frontend
VITE_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdefgh

# ── Backend: Firebase Admin SDK (Optional) ─────────────────
# For server-side Firebase operations (optional)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# ── Environment Detection ──────────────────────────────────
# Set to 'production' or 'development'
NODE_ENV=development
